rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isProfileOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function hasAllowedProfileKeys() {
      return request.resource.data.keys().hasOnly([
        'businessType',
        'businessName',
        'businessSubtype',
        'location',
        'customerPattern',
        'businessRhythm',
        'demandEstimates',
        'roles',
        'hours',
        'busyLevel',
        'peakStaff',
        'csvDemand',
        'dayConfigs',
        'operatingRules',
        'staffingFeedback',
        'ownerUid',
        'updatedAt'
      ]);
    }

    function changesAllowedProfileKeysOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'businessType',
        'businessName',
        'businessSubtype',
        'location',
        'customerPattern',
        'businessRhythm',
        'demandEstimates',
        'roles',
        'hours',
        'busyLevel',
        'peakStaff',
        'csvDemand',
        'dayConfigs',
        'operatingRules',
        'staffingFeedback',
        'ownerUid',
        'updatedAt'
      ]);
    }

    function hasAllowedEmployeeKeys() {
      return request.resource.data.keys().hasOnly([
        'displayName',
        'defaultRole',
        'hourlyRate',
        'active',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasAllowedShiftKeys() {
      return request.resource.data.keys().hasOnly([
        'employeeId',
        'date',
        'startTime',
        'endTime',
        'roleId',
        'breakMinutes',
        'weekStart',
        'ownerUid',
        'createdAt',
        'updatedAt'
      ]);
    }

    function hasAllowedRotaWeekKeys() {
      return request.resource.data.keys().hasOnly([
        'weekStart',
        'status',
        'ownerUid',
        'publishedAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    match /businessProfiles/{userId} {
      allow read: if isProfileOwner(userId);
      allow create: if isProfileOwner(userId)
        && request.resource.data.ownerUid == request.auth.uid
        && hasAllowedProfileKeys();
      allow update: if isProfileOwner(userId)
        && (!('ownerUid' in resource.data) || resource.data.ownerUid == request.auth.uid)
        && request.resource.data.ownerUid == request.auth.uid
        && changesAllowedProfileKeysOnly();
      allow delete: if false;

      match /employees/{employeeId} {
        allow read: if isProfileOwner(userId);
        allow create: if isProfileOwner(userId)
          && request.resource.data.ownerUid == request.auth.uid
          && hasAllowedEmployeeKeys();
        allow update: if isProfileOwner(userId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && hasAllowedEmployeeKeys();
        allow delete: if false;
      }

      match /shifts/{shiftId} {
        allow read: if isProfileOwner(userId);
        allow create: if isProfileOwner(userId)
          && request.resource.data.ownerUid == request.auth.uid
          && hasAllowedShiftKeys();
        allow update: if isProfileOwner(userId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && hasAllowedShiftKeys();
        allow delete: if isProfileOwner(userId)
          && resource.data.ownerUid == request.auth.uid;
      }

      match /rotaWeeks/{weekStart} {
        allow read: if isProfileOwner(userId);
        allow create: if isProfileOwner(userId)
          && request.resource.data.ownerUid == request.auth.uid
          && hasAllowedRotaWeekKeys();
        allow update: if isProfileOwner(userId)
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == request.auth.uid
          && hasAllowedRotaWeekKeys();
        allow delete: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
