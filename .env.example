# Copy this file to .env.local for development and fill in the values from Firebase console.
# Keep real project values out of commits.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key
VITE_ENABLE_SQUARE_INTEGRATION=false

# Server-side Firebase Functions/Square secrets. Set these with Firebase
# Functions secret/config management, not in the Vite browser environment.
ENABLE_SQUARE_INTEGRATION=false
APP_BASE_URL=http://localhost:5173
SQUARE_ENVIRONMENT=sandbox
SQUARE_APPLICATION_ID=your_square_application_id
SQUARE_APPLICATION_SECRET=your_square_application_secret
SQUARE_REDIRECT_URI=http://localhost:5001/your-project/us-central1/squareOAuthCallback
SQUARE_WEBHOOK_NOTIFICATION_URL=http://localhost:5001/your-project/us-central1/squareWebhook
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
SQUARE_TOKEN_ENCRYPTION_KEY=generate_a_32_byte_base64_key

# Production uses app.scheduleloop.co.uk. See .env.production.example for the
# hosting values to configure without breaking local development.
