# Configure these in the production hosting environment for
# https://app.scheduleloop.co.uk. Do not commit real values.

VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=scheduloop-96f9a.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=scheduloop-96f9a
VITE_FIREBASE_STORAGE_BUCKET=scheduloop-96f9a.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_FIREBASE_APPCHECK_RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key
VITE_ENABLE_SQUARE_INTEGRATION=false

# Server-side Firebase Functions/Square values. Set these with Firebase
# Functions secret/config management, not in the Vite browser environment.
ENABLE_SQUARE_INTEGRATION=false
APP_BASE_URL=https://app.scheduleloop.co.uk
SQUARE_ENVIRONMENT=production
SQUARE_APPLICATION_ID=your_square_application_id
SQUARE_APPLICATION_SECRET=your_square_application_secret
SQUARE_REDIRECT_URI=copy_the_deployed_squareOAuthCallback_function_url
SQUARE_WEBHOOK_NOTIFICATION_URL=copy_the_deployed_squareWebhook_function_url
SQUARE_WEBHOOK_SIGNATURE_KEY=your_square_webhook_signature_key
SQUARE_TOKEN_ENCRYPTION_KEY=generate_a_32_byte_base64_key
